logs/

# per-experiment generated artefacts (heavy, regenerable from config.yaml).
# Trailing-slash-only patterns are not anchored, so these match at any depth:
# experiments/<name>/data/, experiments/<sweep>/rep03/results/,
# experiments/<sweep>/rep03/plots/, and so on.
data/
results/
plots/
*.nc
*.zarr

# scratch / throwaway
scripts/throw_away/

# cloned external tool repos (their own git history, not ours)
realdata/external/

# real tree/spectra inputs copied down from Euler for local checks -- real
# data, never committed (see check_tree_inputs.py)
realdata/local_tree_input/

# full COSMIC v3.4 SBS GRCh37 catalogue (raw and converted) -- licence for
